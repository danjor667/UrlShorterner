# Values here are laptop defaults. docker-compose overrides DB_HOST for
# containers, and os.environ wins over this file.

DEBUG=True
SECRET_KEY=change-me-generate-with-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,shortener

# --- Database ---------------------------------------------------------------
# One database, shared by every service. Table names are namespaced by app
# label, so they do not collide inside it.
DB_NAME=urlshortener
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
