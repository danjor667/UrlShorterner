# Values here are laptop defaults. docker-compose overrides DB_HOST for
# containers, and os.environ wins over this file.

DEBUG=True
SECRET_KEY=change-me-generate-with-get_random_secret_key
ALLOWED_HOSTS=localhost,127.0.0.1,shortener

# --- Database ---------------------------------------------------------------
# One database per service, each in its own Postgres container. These values
# are only for running a service directly on the laptop: docker-compose sets
# DB_HOST/DB_NAME/DB_USER/DB_PASSWORD per container and those win over this
# file, so a container can never be pointed at another service's database from
# here.
#
# DB_NAME and DB_USER default to the service's own name — see
# service_database() in libs/common/base_settings.py — so leave them unset
# unless you deliberately want to override them. Setting them here would apply
# to whichever service you run locally, which is rarely what you want once
# there is more than one.
# DB_NAME=shortener
# DB_USER=shortener
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
